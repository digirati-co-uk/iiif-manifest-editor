diff --git a/dist/plugins/diff-source/useTranslatedPhrases.js b/dist/plugins/diff-source/useTranslatedPhrases.js
new file mode 100644
index 0000000..80bb69a
--- /dev/null
+++ b/dist/plugins/diff-source/useTranslatedPhrases.js
@@ -0,0 +1,72 @@
+import React from "react";
+import { Compartment, EditorState } from "@codemirror/state";
+import { searchPanelOpen, closeSearchPanel, openSearchPanel, getSearchQuery, setSearchQuery } from "@codemirror/search";
+import { useTranslation } from "../core/index.js";
+// Instance-local facet updates retain documents, selections, undo history and search queries.
+export function useTranslatedPhrases(viewRef, merge = false) {
+  const t = useTranslation();
+  const compartment = React.useMemo(() => new Compartment(), []);
+  const phrases = {
+    "Find": t("codeMirror.find", "Find"),
+    "Replace": t("codeMirror.replaceField", "Replace"),
+    "next": t("codeMirror.next", "next"),
+    "previous": t("codeMirror.previous", "previous"),
+    "all": t("codeMirror.all", "all"),
+    "match case": t("codeMirror.matchCase", "match case"),
+    "regexp": t("codeMirror.regexp", "regexp"),
+    "by word": t("codeMirror.byWord", "by word"),
+    "replace": t("codeMirror.replace", "replace"),
+    "replace all": t("codeMirror.replaceAll", "replace all"),
+    "close": t("codeMirror.close", "close"),
+    "Go to line": t("codeMirror.goToLine", "Go to line"),
+    "go": t("codeMirror.go", "go"),
+    "current match": t("codeMirror.currentMatch", "current match"),
+    "on line": t("codeMirror.onLine", "on line"),
+    "replaced match on line $": t("codeMirror.replacedMatch", "replaced match on line $"),
+    "replaced $ matches": t("codeMirror.replacedMatches", "replaced $ matches"),
+    "Selection deleted": t("codeMirror.selectionDeleted", "Selection deleted"),
+    "Folded lines": t("codeMirror.foldedLines", "Folded lines"),
+    "Unfolded lines": t("codeMirror.unfoldedLines", "Unfolded lines"),
+    "to": t("codeMirror.to", "to"),
+    "folded code": t("codeMirror.foldedCode", "folded code"),
+    "unfold": t("codeMirror.unfold", "unfold"),
+    "Fold line": t("codeMirror.foldLine", "Fold line"),
+    "Unfold line": t("codeMirror.unfoldLine", "Unfold line"),
+    "Completions": t("codeMirror.completions", "Completions"),
+    "Diagnostics": t("codeMirror.diagnostics", "Diagnostics"),
+    "No diagnostics": t("codeMirror.noDiagnostics", "No diagnostics"),
+    "Control character": t("codeMirror.controlCharacter", "Control character"),
+    "Loading\u2026": t("codeMirror.loading", "Loading\u2026"),
+    "No completions": t("codeMirror.noCompletions", "No completions"),
+    "original": t("codeMirror.original", "original"),
+    "modified": t("codeMirror.modified", "modified"),
+    "Revert this chunk": t("codeMirror.revert", "Revert this chunk")
+  };
+  const signature = JSON.stringify(phrases);
+  React.useEffect(() => {
+    const views = merge ? [viewRef.current?.a, viewRef.current?.b] : [viewRef.current];
+    for (const view of views) {
+      if (!view) continue;
+      const open = searchPanelOpen(view.state);
+      const query = open ? getSearchQuery(view.state) : null;
+      const active = document.activeElement;
+      const controls = [...view.dom.querySelectorAll(".cm-search input, .cm-search button")];
+      const focusedIndex = controls.indexOf(active);
+      const selection = active?.tagName === "INPUT" && active.type !== "checkbox"
+        ? [active.selectionStart, active.selectionEnd, active.selectionDirection] : null;
+      if (open) closeSearchPanel(view);
+      view.dispatch({ effects: compartment.reconfigure(EditorState.phrases.of(JSON.parse(signature))) });
+      if (open) {
+        openSearchPanel(view);
+        view.dispatch({ effects: setSearchQuery.of(query) });
+        const control = view.dom.querySelectorAll(".cm-search input, .cm-search button")[focusedIndex];
+        if (control) {
+          control.focus();
+          if (selection) control.setSelectionRange(...selection);
+        } else if (active === view.contentDOM) view.focus();
+        else if (active?.isConnected) active.focus();
+      }
+    }
+  }, [signature, compartment, merge, viewRef]);
+  return compartment.of(EditorState.phrases.of(phrases));
+}
