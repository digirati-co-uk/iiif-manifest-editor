+const { createContext, createElement, useContext } = require("react");
+
+const BrowserI18nContext = createContext(undefined);
+const english = (key, fallback, values) => fallback.replace(/\{\{(\w+)\}\}/g, (_, name) => String(values?.[name] ?? ""));
+function BrowserI18nProvider({ i18n, children }) {
+  const inherited = useContext(BrowserI18nContext);
+  return createElement(BrowserI18nContext.Provider, { value: i18n ?? inherited }, children);
+}
+function useBrowserI18n() {
+  const i18n = useContext(BrowserI18nContext);
+  return { locale: i18n?.locale, direction: i18n?.direction, t: i18n?.translate ?? english, formatRelativeTime: i18n?.formatRelativeTime };
+}
+function displayBrowserLabel(item, t) {
+  if (item?.labelMessage) return t(item.labelMessage, item.label, item.labelValues);
+  if (item?.label !== undefined) return item.label;
+  const defaults = { clipboard: ["copyToClipboard", "Copy to clipboard"], callback: ["select", "Select"], input: ["select", "Select"], "event-emitter": ["select", "Select"], "open-new-window": ["open", "Open"], download: ["download", "Download"] };
+  const fallback = defaults[item?.type];
+  return fallback ? t(...fallback) : "";
+}
+function displayBrowserTitle(item, t) { return item?.titleMessage ? t(item.titleMessage, item.title) : item?.title; }
+function Diagnostic({ error }) {
+  const { t } = useBrowserI18n();
+  return createElement("div", null, t("actionFailed", "Action failed. Try again."), createElement("details", null, createElement("summary", null, t("technicalDetails", "Technical details")), createElement("pre", null, String(error))));
+}
+function browserDiagnostic(error) { return createElement(Diagnostic, { error }); }
+
+exports.BrowserI18nProvider = BrowserI18nProvider;
+exports.useBrowserI18n = useBrowserI18n;
+exports.displayBrowserLabel = displayBrowserLabel;
+exports.displayBrowserTitle = displayBrowserTitle;
+exports.browserDiagnostic = browserDiagnostic;
+exports.browserElement = createElement;
