+// Scope hold-Space-to-pan to the focused viewer, without taking keys from controls.
+function installSpacePanShortcut({ root, preset, setMode, setContainerClassName }) {
+  if (!root || !preset) return () => {};
+  const doc = root.ownerDocument;
+  const win = doc.defaultView;
+  if (!win) return () => {};
+  const isInteractive = (node) => node instanceof win.HTMLElement &&
+    (node.isContentEditable || !!node.closest(
+      'input, textarea, select, button, a[href], [role="textbox"], [role="combobox"], [role="slider"], [role="spinbutton"]'
+    ));
+  let holding = false;
+  let addedTabIndex = false;
+  const focusViewer = (event) => {
+    if (event.button !== 0 || event.composedPath().some(isInteractive)) return;
+    if (!root.hasAttribute('tabindex')) {
+      root.tabIndex = 0;
+      addedTabIndex = true;
+    }
+    root.focus({ preventScroll: true });
+  };
+  const release = () => {
+    if (!holding) return;
+    holding = false;
+    if (preset.runtime.mode === 'explore') {
