{
  "name": "@manifest-editor/i18n",
  "version": "2.2.1",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/core.ts",
    "./package.json": "./package.json",
    "./nl": "./src/nl.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./core": {
        "import": {
          "types": "./dist/core.d.ts",
          "default": "./dist/core.js"
        },
        "require": {
          "types": "./dist/core.d.cts",
          "default": "./dist/core.cjs"
        }
      },
      "./package.json": "./package.json",
      "./nl": {
        "import": {
          "types": "./dist/nl.d.ts",
          "default": "./dist/nl.js"
        },
        "require": {
          "types": "./dist/nl.d.cts",
          "default": "./dist/nl.cjs"
        }
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint src test"
  },
  "dependencies": {
    "i18next": "26.5.11",
    "react-i18next": "17.1.9"
  },
  "peerDependencies": {
    "react": ">=18.2.0"
  },
  "devDependencies": {
    "@manifest-editor/languages": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "jsdom": "26.1.0",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
