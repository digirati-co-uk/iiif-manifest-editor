{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "@manifest-editor/editor-api": ["../editor-api/src/index.ts"],
      "@manifest-editor/shell": ["../shell/src/index.ts"],
      "@manifest-editor/components": ["../components/src/index.tsx"],
      "@manifest-editor/creator-api": ["../creator-api/src/index.ts"],
      "@manifest-editor/client-vault": ["../client-vault/src/index.ts"]
    }
  },
  "exclude": ["src/**/*.test.ts", "src/**/*.stories.tsx"]
}
