{
  "name": "iiif-manifest-editor",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/digirati-co-uk/iiif-manifest-editor.git"
  },
  "scripts": {
    "build": "turbo build",
    "build-packages": "turbo build --filter=@manifest-editor/* --filter=manifest-editor",
    "predev": "turbo build --filter=@manifest-editor/annotations --filter=@manifest-editor/canvas-label-generator --filter=@manifest-editor/ocr-classification --filter=@manifest-editor/ocr-docling --filter=@manifest-editor/translation",
    "dev": "turbo dev --filter='web...' --filter='!./plugins/*' --concurrency=16",
    "dev-full": "turbo dev --filter='web...' --filter='./plugins/*' --concurrency=24",
    "dev:plugins": "turbo watch build --filter='./plugins/*' --only --concurrency=10 --ui=stream",
    "lint": "oxlint . --deny-warnings && turbo lint",
    "lint:ci": "oxlint . && turbo lint",
    "lint:fix": "oxlint . --fix",
    "lint:staged": "lint-staged",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "prepare": "simple-git-hooks",
    "mismatch": "syncpack lint",
    "fix-deps": "syncpack fix",
    "bump": "syncpack fix && lerna version --no-private && syncpack fix",
    "versionup": "lerna version",
    "ci:versionup:patch": "lerna version patch --no-push --no-git-tag-version --yes && npm run commit-version",
    "ci:versionup:minor": "lerna version minor --no-push --no-git-tag-version --yes && npm run commit-version",
    "ci:versionup:major": "lerna version major --no-push --no-git-tag-version --yes && npm run commit-version",
    "commit-version": "git add . && git commit -m \"chore(release): v`node -p 'require(\"./lerna.json\").version'`\"",
    "release": "lerna publish from-package",
    "release-next": "lerna publish --preid next --pre-dist-tag next --canary --force-publish --no-git-reset",
    "ci:release": "lerna publish from-package --yes",
    "ci:release-next": "lerna publish --preid next --pre-dist-tag next --canary --force-publish --no-git-reset --yes"
  },
  "devDependencies": {
    "@lerna-lite/cli": "^5.4.2",
    "@lerna-lite/list": "^5.4.2",
    "@lerna-lite/publish": "^5.4.2",
    "@lerna-lite/version": "^5.4.2",
    "@repo/typescript-config": "workspace:*",
    "pkg-pr-new": "^0.0.87",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "publint": "^0.3.23",
    "rolldown": "1.2.3",
    "syncpack": "^15.3.3",
    "tailwindcss": "^3.4.3",
    "tslib": "^2.8.1",
    "turbo": "^2.10.9",
    "typescript": "catalog:",
    "typescript-plugin-css-modules": "^5.2.0",
    "simple-git-hooks": "^2.13.1"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint:staged"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": "oxlint --fix"
  },
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  }
}
